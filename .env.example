# Public URL of the deployed site. Used for canonical URLs, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. A form backend that accepts a JSON POST (for example https://formspree.io/f/xxxxxxx).
# When unset, the contact form opens the visitor's email app with the message filled in.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# React Bits Pro license key, used by components.json to install registry components (shadcn CLI).
# Put the real value in .env.local, never in this file.
REACTBITS_LICENSE_KEY=
